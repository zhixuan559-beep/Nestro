<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="120"
    android:viewportHeight="120">
    <!-- 中灰底：黑白两色块都不描边，全靠底色衬出圆的外缘（黑白灰单色纪律） -->
    <path android:fillColor="#808080" android:pathData="M0,0h120v120h-120z" />
    <!-- 左鱼：纯黑实色块，S 形分界由两段 r=28 内弧构成 -->
    <path
        android:fillColor="#111111"
        android:pathData="M60,4 A56,56 0 0,0 60,116 A28,28 0 0,1 60,60 A28,28 0 0,0 60,4 Z" />
    <!-- 右鱼：纯白实色块，与左鱼共用 S 形分界，无缝咬合 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M60,4 A56,56 0 0,1 60,116 A28,28 0 0,0 60,60 A28,28 0 0,1 60,4 Z" />
    <!-- 上鱼眼：落在白鱼区，取黑色 -->
    <path
        android:fillColor="#111111"
        android:pathData="M51,32 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z" />
    <!-- 下鱼眼：落在黑鱼区，取白色 -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M51,88 a9,9 0 1,0 18,0 a9,9 0 1,0 -18,0 Z" />
</vector>
