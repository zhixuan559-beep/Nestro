# Set these in the deployment secret manager; never commit real credentials.
PORT=8080
PUBLIC_BASE_URL=https://oauth-api.example.com
MODELSCOPE_CLIENT_ID=
MODELSCOPE_CLIENT_SECRET=
MODELSCOPE_REDIRECT_URI=https://oauth-api.example.com/oauth/modelscope/callback
NESTRO_APP_CALLBACK_URI=nestro://oauth/modelscope
ALLOWED_APP_CALLBACKS=nestro://oauth/modelscope
SESSION_TTL_SECONDS=300
